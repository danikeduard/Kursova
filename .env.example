SECRET_KEY=replace-with-a-long-random-secret
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq
# Leave enough output tokens for structured CEFR evaluation, especially with reasoning models.
LLM_MAX_TOKENS_EVALUATOR=1024
# For the OpenAI-compatible provider, set LLM_PROVIDER=openai and provide:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
DAILY_MESSAGE_CAP=50
RATE_LIMIT_CHAT=30 per minute
APP_ENV=development
TRUSTED_PROXY_COUNT=0
RATELIMIT_STORAGE_URI=memory://
MAX_CONTENT_LENGTH=65536
SESSION_COOKIE_SECURE=false
DEMO_MODE=false
# Set these to your provider's current per-token prices to enable estimated API cost tracking.
# Zero disables cost estimates; these values must be configured from the provider's pricing page.
LLM_COST_PER_1K_INPUT_USD=0
LLM_COST_PER_1K_OUTPUT_USD=0
